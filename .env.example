# Canvas
CANVAS_URL=https://uncch.instructure.com
CANVAS_TOKEN=

# LLM: a chain of OpenAI-compatible providers. Order: Groq, then Cerebras. A provider whose key isn't set is skipped.
GROQ_API_KEY=            # (the older LLM_API_KEY still works for Groq)
CEREBRAS_API_KEY=
# Cerebras is paid (prepaid credits). Once it has used this many tokens in a day (midnight ET reset) it is skipped.
# CEREBRAS_DAILY_TOKEN_CAP=300000
# Blended $/1M tokens, only for the spend estimate shown in /llm
# CEREBRAS_USD_PER_M_TOKENS=0.70
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Change the chain: "provider:model" entries (built-in providers: groq, cerebras), or a JSON array of
# {provider, baseUrl, keyEnv, model[, rpm, dailyTokens, dailyRequests]} entries.
# LLM_PROVIDERS=groq:openai/gpt-oss-120b,cerebras:gpt-oss-120b
# Optional Groq model list (comma-separated, tried in order before the next provider).
# Groq's rate limits are per MODEL, so each model has its own daily budget. All must support tool calling
# (see console.groq.com/docs/tool-use). Example:
# LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile

TIMEZONE=America/New_York

# What the assistant calls itself (prompt, morning brief, invite, welcome, connect page)
BOT_NAME=Pallas

# terminal | local | cloud
PROVIDER=terminal
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Comma-separated phone numbers (+19195551234) or emails allowed to talk to the bot
ALLOWED_SENDERS=

# iCloud Calendar (CalDAV). Use an app-specific password from appleid.apple.com
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# Optional: SQLite file for history + notification state
# DB_PATH=canvas-bot.db

# --- Multi-user (optional) ---
# Invites and web onboarding turn on only when BOTH PUBLIC_URL and ENCRYPTION_KEY are set.
# Public https URL of this service (Railway domain), no trailing slash
PUBLIC_URL=
# 32 random bytes, base64. Generate with: openssl rand -base64 32  (losing it makes stored tokens unreadable)
ENCRYPTION_KEY=
# Canvas hosts members may connect (comma-separated). Anything else is rejected.
ALLOWED_CANVAS_HOSTS=uncch.instructure.com
# Daily LLM token caps. Groq's free tier gives the whole key ~200K tokens/day, shared by everyone,
# so cap each user: members, and the owner (higher)
LLM_DAILY_TOKENS_PER_USER=50000
LLM_DAILY_TOKENS_OWNER=100000
# Most people the Photon plan allows: 10 on Free, 100 on Pro
PHOTON_USER_LIMIT=10
# Shown in the first text to someone you invite ("<name> invited you")
OWNER_NAME=
# Port for the onboarding page (Railway sets this itself)
# PORT=3000

# --- LLM tuning (optional) ---
# gpt-oss reasoning effort: low | medium | high (low is cheapest; ignored for other models)
# LLM_REASONING_EFFORT=low
# Max tokens the model may write per round
# LLM_MAX_OUTPUT_TOKENS=1500
# For local development use a DIFFERENT Groq key (or org) and/or a cheap model in .env.local,
# so experiments never spend the production key's daily quota. Tests mock the LLM and cannot call it.

# One account-setup email after sign-up ("Text Pallas at <number> to get started"), via Resend. Unset: no email is sent.
# EMAIL_FROM must be an address on a domain you verified in Resend; the default (onboarding@resend.dev) only reaches your own Resend account email.
# RESEND_API_KEY=
# EMAIL_FROM=Pallas <hello@example.com>
